{
  "name": "anime-calendar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:update": "node dist/server/server/update.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "undici": "8.12.3",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/express": "5.0.6",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "vue-tsc": "3.3.13",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
